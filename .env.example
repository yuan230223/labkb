# Copy to .env. Never commit a real token or laboratory documents.
LABKB_MODE=demo
LABKB_DATA_DIR=data
LABKB_OLLAMA_URL=http://127.0.0.1:11434
LABKB_CHAT_MODEL=qwen3:8b
LABKB_EMBED_MODEL=qwen3-embedding:0.6b
LABKB_NUM_CTX=8192
LABKB_SEMANTIC_THRESHOLD=0.55
# Required (at least 24 characters) for Docker or a non-loopback bind.
LABKB_API_TOKEN=
